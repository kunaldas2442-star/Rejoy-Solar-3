rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped Admin: user email dasest404@gmail.com or registered in admin collection or role == 'Admin' in users
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.email == 'dasest404@gmail.com' || request.auth.token.email == 'kunaldas2442@gmail.com');
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string && data.role.size() <= 50;
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             data.status is string && data.status in ['NEW', 'CONTACTED', 'QUALIFIED', 'SITE SURVEY', 'PROPOSAL', 'NEGOTIATION', 'WON', 'LOST'];
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.city is string && data.city.size() <= 100 &&
             data.status is string && data.status in ['ACTIVE', 'COMPLETED', 'ON HOLD', 'CANCELLED'];
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectCode is string && data.projectCode.size() <= 60 &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.status is string && data.status in [
               'PLANNING', 'SURVEY', 'DESIGN & APPROVALS', 'CIVIL & STRUCTURE',
               'INSTALLATION', 'TESTING & COMMISSIONING', 'HANDOVER', 'COMPLETED',
               'DELAYED', 'ON HOLD'
             ];
    }

    function isValidQuotation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.quotationNumber is string && data.quotationNumber.size() <= 60 &&
             data.customerName is string && data.customerName.size() <= 120 &&
             data.grandTotal is number &&
             data.status is string && data.status in ['DRAFT', 'SENT', 'ACCEPTED', 'REJECTED', 'EXPIRED'];
    }

    function isValidServiceTicket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.ticketNumber is string && data.ticketNumber.size() <= 60 &&
             data.customerName is string && data.customerName.size() <= 120 &&
             data.issue is string && data.issue.size() <= 500 &&
             data.priority is string && data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             data.status is string && data.status in ['OPEN', 'ASSIGNED', 'IN PROGRESS', 'RESOLVED', 'CLOSED'];
    }

    // Collections
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        (isOwner(userId) && (!incoming().keys().hasAny(['role']) || incoming().role == 'Customer' || isSuperAdmin())) ||
        isAdmin()
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'department', 'designation']))
      );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /leads/{leadId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leadId) && isValidLead(incoming());
      allow update: if isSignedIn() && isValidId(leadId) && isValidLead(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'estimatedValue', 'solarCapacityKw', 'assignedSalespersonId', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(leadId) && isAdmin();
    }

    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidId(customerId) && isValidCustomer(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'siteAddress', 'city', 'state', 'pincode', 'status', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(customerId) && isAdmin();
    }

    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentStageKey', 'totalValue', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(projectId) && isAdmin();
    }

    match /quotations/{quotationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(quotationId) && isValidQuotation(incoming());
      allow update: if isSignedIn() && isValidId(quotationId) && isValidQuotation(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'grandTotal', 'items', 'notes', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(quotationId) && isAdmin();
    }

    match /serviceTickets/{ticketId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(ticketId) && isValidServiceTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidServiceTicket(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'issue', 'assignedTo', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
